<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="MobileBase" type="system">
        <hardware>
            <!-- <plugin>mock_components/GenericSystem</plugin>
            <param name="calculate_dynamics">true</param> -->
            <plugin>hardware/MobileBaseHardwareInterface</plugin>
            <param name="left_wheel_name">base_right_wheel_joint</param>
            <param name="right_wheel_name">base_left_wheel_joint</param>
            <param name="loop_rate">30</param>
            <param name="port">/dev/ttyUSB0</param>
            <param name="baud_rate">115200</param>
            <param name="timeout">1000</param>
            <param name="enc_counts_per_rev">20</param>
            <!-- There is 2 PIDs: one to control motors pwm, second to navigate the path -->
            <param name="pid_p">30</param>
            <param name="pid_i">20</param>
            <param name="pid_d">0</param>
            <param name="pid_o">1</param>
            <!-- <param name="nav_pid_p">1</param> -->
            <!-- <param name="nav_pid_i">0.01</param> -->
            <!-- <param name="nav_pid_d">0.04</param> -->
            <!-- <param name="nav_max_windup">20</param> -->
            <!-- <param name="nav_max_input">255</param> -->
        </hardware>
        <joint name="base_right_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="base_left_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>

</robot>
