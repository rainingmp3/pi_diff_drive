  <version>0.0.0</version>
  <description>Hardware interface for Diff Drive robot</description>
  <maintainer email="ioankotanov@gmail.com">Ivane Kotanov</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>serial</depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
